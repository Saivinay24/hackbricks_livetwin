# ── Local dev: Lakebase connection ──────────────────────────────────────────
LAKEBASE_HOST=your-lakebase-host.databricks.com
LAKEBASE_PASSWORD=your-personal-access-token
LAKEBASE_USER=token
LAKEBASE_DB=livetwin
PORT=8000

# ── Databricks workspace (for ./scripts/start.sh --databricks) ──────────────
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_TOKEN=your-personal-access-token

# ── Optional: repo path inside workspace ────────────────────────────────────
REPO_PATH=/Workspace/Repos/livetwin
